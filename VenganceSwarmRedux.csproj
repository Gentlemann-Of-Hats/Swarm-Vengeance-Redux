<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>VenganceSwarmRedux</AssemblyName>
    <RootNamespace>VengeanceSwarmRedux</RootNamespace>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <!-- Local Paths to Game and Mod Manager directories -->
    <RoR2ManagedDir>/home/nicholasjohnson/drives/Sata_games/Steamlibrary/steamapps/common/Risk of Rain 2/Risk of Rain 2_Data/Managed</RoR2ManagedDir>
    <R2ModmanProfileDir>/home/nicholasjohnson/.config/r2modmanPlus-local/RiskOfRain2/profiles/Test</R2ModmanProfileDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ref\**" />
    <EmbeddedResource Remove="ref\**" />
    <None Remove="ref\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx packages -->
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Risk of Rain 2 Game Assemblies -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RoR2ManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RoR2">
      <HintPath>$(RoR2ManagedDir)/RoR2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RoR2ManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RoR2ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(RoR2ManagedDir)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(RoR2ManagedDir)/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.unity.multiplayer-hlapi.Runtime">
      <HintPath>$(RoR2ManagedDir)/com.unity.multiplayer-hlapi.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HGCSharpUtils">
      <HintPath>$(RoR2ManagedDir)/HGCSharpUtils.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- HookGen MMHOOK Assembly -->
    <Reference Include="MMHOOK_RoR2">
      <HintPath>$(R2ModmanProfileDir)/BepInEx/plugins/MMHOOK/MMHOOK_RoR2.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Risk Of Options Soft Dependency Assembly -->
    <Reference Include="RiskOfOptions">
      <HintPath>$(R2ModmanProfileDir)/BepInEx/plugins/Rune580-Risk_Of_Options/RiskOfOptions/RiskOfOptions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <!-- Copy to r2modman 'Test' profile locations for instant testing -->
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(R2ModmanProfileDir)/BepInEx/plugins/Unknown-VenganceSwarmRedux.dll/VenganceSwarmRedux.dll" Condition="Exists('$(R2ModmanProfileDir)/BepInEx/plugins/Unknown-VenganceSwarmRedux.dll')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(R2ModmanProfileDir)/BepInEx/plugins/VenganceSwarmRedux/VenganceSwarmRedux.dll" />

    <!-- Copy Release builds to the Thunderstore release directory -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="/home/nicholasjohnson/Code-Projects/ThunderStrore-Release/ror2/VenganceSwarmRedux/Release/" Condition="'$(Configuration)' == 'Release'" />
  </Target>

</Project>
